# TRINFRA Environment Variables — Zero-Budget Demo Configuration
# ==============================================================================
# Database Configuration: Supabase PostgreSQL (Free Tier)
# ==============================================================================

# 1. DATABASE_URL: Supabase Connection Pooler (Transaction Mode, Port 6543)
# Used by Next.js serverless functions and runtime Prisma queries on Vercel.
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Supabase Direct Connection (Session Mode, Port 5432)
# Used by Prisma CLI for running migrations and db push.
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used for signing admin session tokens (min 32 characters)
SESSION_SECRET="your-session-secret-at-least-32-chars-long"

# ==============================================================================
# Document Storage
# ==============================================================================
# Local directory for private documents during development.
# On Vercel serverless, ephemeral storage /tmp/storage/documents is automatically used.
UPLOAD_DIR="./storage/documents"

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
