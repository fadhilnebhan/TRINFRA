datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  fullName     String
  phone        String?
  companyName  String?
  role         String               @default("ADMIN") // ADMIN | SELLER | BUYER
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  adminNotes   AdminNote[]
  listings     ResidentialListing[]
  enquiries    ResidentialEnquiry[]
}

model Landowner {
  id                     String      @id @default(cuid())
  referenceNumber        String      @unique // e.g. TRI-2026-00001
  ownerType              String      @default("Individual") // Individual | Family | Group
  fullName               String
  email                  String
  phone                  String
  alternatePhone         String?
  preferredCommunication String      @default("WhatsApp") // WhatsApp | Phone Call | Email
  district               String
  localBody              String
  locality               String
  address                String?
  approximateArea        Float       @default(0)
  areaUnit               String      @default("Acres") // Acres | Cents | Hectares
  ownershipStatus        String      @default("Sole Ownership") // Sole Ownership | Joint Ownership | Family Inherited | Community
  poolingInterest        String      @default("Join Existing Pool") // Join Existing Pool | Initiate New Pool | Explore Options
  verificationStatus     String      @default("NEW") // NEW | VERIFICATION_PENDING | VERIFIED | NEEDS_CLARIFICATION | REJECTED
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  parcels    LandParcel[]
  documents  Document[]
  adminNotes AdminNote[]
}

model LandParcel {
  id              String       @id @default(cuid())
  landownerId     String
  landowner       Landowner    @relation(fields: [landownerId], references: [id], onDelete: Cascade)
  surveyNumber    String?
  district        String
  localBody       String
  locality        String
  approximateArea Float
  areaUnit        String       @default("Acres")
  latitude        Float?
  longitude       Float?
  ownershipStatus String?
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  documents Document[]
}

model Opportunity {
  id                   String             @id @default(cuid()) // e.g. OPP-1
  title                String
  slug                 String             @unique
  location             String
  district             String
  locality             String
  area                 Float
  areaUnit             String             @default("Acres")
  landownersCount      Int                @default(1)
  status               String             @default("OPEN") // OPEN | IN_PROGRESS | FORMING | UNDER_REVIEW | CLOSED
  shortDescription     String
  overview             String
  highlights           String? // JSON array string
  developmentPotential String?
  currentStatusDetail  String?
  image                String
  latitude             Float?
  longitude            Float?
  isPinned             Boolean            @default(false)
  pinnedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  parcels    LandParcel[]
  projects   Project[]
  enquiries  DeveloperEnquiry[]
  adminNotes AdminNote[]

  @@index([isPinned, pinnedAt])
}

model Project {
  id                      String             @id @default(cuid()) // e.g. PROJ-1
  title                   String
  slug                    String             @unique
  location                String
  district                String
  approximateArea         String
  areaNum                 Float
  participatingLandowners Int                @default(1)
  status                  String             @default("PLANNING") // PLANNING | IN_PROGRESS | DEVELOPMENT | COMPLETED
  developmentStage        String             @default("PLANNING") // LAND_AGGREGATION | PLANNING | APPROVALS | DEVELOPMENT | COMPLETED
  progressPercentage      Int                @default(0)
  image                   String
  description             String
  overview                String
  tags                    String? // JSON array string
  featured                Boolean            @default(false)
  opportunityId           String?
  opportunity             Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  enquiries  DeveloperEnquiry[]
  adminNotes AdminNote[]
}

model DeveloperEnquiry {
  id                     String       @id @default(cuid())
  referenceNumber        String       @unique // e.g. TRI-ENQ-2026-00001
  fullName               String
  company                String
  email                  String
  phone                  String
  preferredContactMethod String?      @default("Phone")
  role                   String       @default("developer") // developer | investor | other
  interestType           String?      @default("request_info") // request_info | explore_partnership | schedule_discussion | not_sure
  investmentRange        String?
  preferredLocation      String?
  message                String
  opportunityId          String?
  opportunity            Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectId              String?
  project                Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status                 String       @default("NEW") // NEW | CONTACTED | QUALIFIED | FOLLOW_UP | CLOSED | REJECTED
  priority               String       @default("NORMAL") // LOW | NORMAL | HIGH
  internalNotes          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  adminNotes AdminNote[]
}

model Document {
  id                 String      @id @default(cuid())
  landownerId        String?
  landowner          Landowner?  @relation(fields: [landownerId], references: [id], onDelete: Cascade)
  landParcelId       String?
  landParcel         LandParcel? @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  documentType       String      @default("OWNERSHIP") // IDENTITY | OWNERSHIP | LAND_RECORD | SURVEY | OTHER
  fileName           String
  filePath           String // Local filesystem path (never public)
  mimeType           String
  fileSize           Int
  verificationStatus String      @default("PENDING_REVIEW") // PENDING_REVIEW | VERIFIED | FLAGGED
  uploadedAt         DateTime    @default(now())
}

model AdminNote {
  id            String            @id @default(cuid())
  adminId       String?
  admin         User?             @relation(fields: [adminId], references: [id], onDelete: SetNull)
  authorName    String            @default("Admin Reviewer")
  authorRole    String            @default("Lead Coordinator")
  landownerId   String?
  landowner     Landowner?        @relation(fields: [landownerId], references: [id], onDelete: Cascade)
  enquiryId     String?
  enquiry       DeveloperEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content       String
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  type        String // registration_received | enquiry_received | verification_updated | system
  title       String
  message     String
  recipientId String?
  reference   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ResidentialListing {
  id              String             @id @default(cuid())
  sellerId        String
  seller          User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  slug            String             @unique
  propertyType    String             // Apartment | Flat | Villa | House | Penthouse
  listingPurpose  String             // Sale | Rent
  description     String
  district        String             // 14 Kerala districts
  locality        String
  address         String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  area            Float
  areaUnit        String             @default("sq ft")
  bedrooms        Int
  bathrooms       Int
  floor           Int?
  totalFloors     Int?
  furnishedStatus String?            // Unfurnished | Semi-Furnished | Fully Furnished
  parking         String?            // Covered | Open | None
  balcony         Int?
  propertyAge     String?            // Under Construction | Ready to Move | 0-1 years | 1-5 years | 5+ years
  facing          String?            // East | West | North | South | North-East | North-West | South-East | South-West
  price           Float
  priceType       String             @default("Total") // Total | Per sq ft | Per Month
  negotiable      Boolean            @default(false)
  amenities       String[]           @default([])
  status          String             @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | UNPUBLISHED | SOLD | RENTED | ARCHIVED
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  publishedAt     DateTime?

  images          ResidentialImage[]
  enquiries       ResidentialEnquiry[]

  @@index([district, status])
  @@index([sellerId])
  @@index([propertyType])
  @@index([listingPurpose])
  @@index([price])
  @@index([bedrooms])
  @@index([status, createdAt])
}

model ResidentialImage {
  id         String             @id @default(cuid())
  listingId  String
  listing    ResidentialListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  filename   String
  mimeType   String
  size       Int
  sortOrder  Int                @default(0)
  isCover    Boolean            @default(false)
  createdAt  DateTime           @default(now())

  @@index([listingId, sortOrder])
}

model ResidentialEnquiry {
  id        String             @id @default(cuid())
  listingId String
  listing   ResidentialListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     User?              @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String
  message   String
  status    String             @default("NEW") // NEW | CONTACTED | IN_PROGRESS | CLOSED
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

